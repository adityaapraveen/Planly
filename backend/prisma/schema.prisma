generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  projects        Project[]
  refreshSessions RefreshSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  drawings Drawing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

model Drawing {
  id String @id @default(uuid())

  fileName String
  filePath String @map("fileUrl")
  mimeType String
  size     Int

  status DrawingStatus @default(PENDING)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  pages DrawingPage[]

  analyses Analysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("drawings")
}

model DrawingPage {
  id String @id @default(uuid())

  pageNumber Int

  imagePath String
  imageName String

  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("drawing_pages")
}

model Analysis {
  id             String  @id @default(uuid())
  score          Int?
  summary        String?
  issuesSnapshot Json?   @map("issues")
  rawOutput      Json?
  reportUrl      String?

  reviewMode    ReviewMode     @default(SUBMISSION_READINESS)
  status        AnalysisStatus @default(PENDING)
  errorCode     String?
  errorMessage  String?
  provider      String?
  model         String?
  promptVersion String         @default("v1")
  attempt       Int            @default(0)
  durationMs    Int?
  startedAt     DateTime?
  completedAt   DateTime?

  drawingId String
  drawing   Drawing         @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  issues    AnalysisIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([drawingId, reviewMode, createdAt])
  @@index([status])
  @@map("analyses")
}

model AnalysisIssue {
  id             String              @id @default(uuid())
  title          String
  category       String
  severity       String
  confidence     Float
  page           Int
  x              Float
  y              Float
  width          Float
  height         Float
  hasLocation    Boolean             @default(true)
  explanation    String
  recommendation String
  status         AnalysisIssueStatus @default(OPEN)

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analysisId, status])
  @@index([severity])
  @@map("analysis_issues")
}

model RefreshSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

enum ReviewMode {
  SUBMISSION_READINESS
  DOCUMENTATION_REVIEW
  CONSTRUCTABILITY_REVIEW
  COORDINATION_REVIEW
  COMPLIANCE_RISK_REVIEW
}

enum DrawingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AnalysisIssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}
