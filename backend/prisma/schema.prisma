generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  projects            Project[]
  refreshSessions     RefreshSession[]
  findingReviewEvents AnalysisIssueReviewEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  drawings       Drawing[]
  questions      ProjectQuestion[]
  checkSettings  ProjectCheckSetting[]
  evidenceChunks ProjectEvidenceChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

model ProjectQuestion {
  id               String                @id @default(uuid())
  question         String
  answer           String
  status           ProjectQuestionStatus
  confidence       Float
  citations        Json
  evidenceSnapshot Json
  provider         String?
  model            String?
  promptVersion    String                @default("cited-project-qa-v1")
  retrievalMode    String                @default("LEXICAL")
  retrievalTrace   Json?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("project_questions")
}

model ProjectEvidenceChunk {
  id                  String  @id @default(uuid())
  sourceId            String
  evidenceType        String
  title               String
  content             String
  contentHash         String
  metadata            Json
  embedding           Json?
  embeddingModel      String?
  embeddingDimensions Int?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, sourceId])
  @@index([projectId, evidenceType])
  @@index([projectId, updatedAt])
  @@map("project_evidence_chunks")
}

model ProjectCheckSetting {
  id       String        @id @default(uuid())
  checkKey String
  enabled  Boolean       @default(true)
  severity CheckSeverity
  version  String        @default("v1")

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, checkKey])
  @@index([projectId, enabled])
  @@map("project_check_settings")
}

model Drawing {
  id String @id @default(uuid())

  fileName String
  filePath String @map("fileUrl")
  mimeType String
  size     Int

  status DrawingStatus @default(PENDING)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  revisionOfId String?
  revisionOf   Drawing?  @relation("DrawingRevisionHistory", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions    Drawing[] @relation("DrawingRevisionHistory")

  pages DrawingPage[]

  analyses Analysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([revisionOfId])
  @@map("drawings")
}

model DrawingPage {
  id String @id @default(uuid())

  pageNumber Int

  imagePath String
  imageName String

  nativeText              String?
  nativeArtifacts         Json?
  nativeExtractionStatus  NativePdfExtractionStatus @default(PENDING)
  nativeExtractionVersion String?
  nativeExtractionError   String?
  nativeExtractedAt       DateTime?

  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  sheet           Sheet?
  sheetReferences SheetReference[]
  regions         DrawingPageRegion[]

  createdAt DateTime @default(now())

  @@index([nativeExtractionStatus])
  @@map("drawing_pages")
}

model DrawingPageRegion {
  id String @id @default(uuid())

  key     String
  kind    DrawingPageRegionKind
  version String
  status  DrawingPageRegionStatus @default(PENDING)
  error   String?

  x      Float
  y      Float
  width  Float
  height Float
  dpi    Int

  pixelWidth  Int
  pixelHeight Int
  imagePath   String?
  imageName   String?

  pageId String
  page   DrawingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageId, key])
  @@index([pageId, status])
  @@map("drawing_page_regions")
}

model Sheet {
  id String @id @default(uuid())

  sheetNumber String?
  title       String?
  discipline  String?
  revision    String?
  issueDate   String?

  confidence         Float             @default(0)
  fieldConfidence    Json
  evidence           Json
  titleBlockLocation Json?
  reviewStatus       SheetReviewStatus @default(NEEDS_REVIEW)
  metadataVersion    String            @default("v1")
  correctedAt        DateTime?

  pageId String      @unique
  page   DrawingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  incomingReferences SheetReference[] @relation("ReferenceTargetSheet")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sheetNumber])
  @@index([reviewStatus])
  @@map("sheets")
}

model SheetReference {
  id String @id @default(uuid())

  referenceType     SheetReferenceType
  label             String
  detailNumber      String?
  targetSheetNumber String
  confidence        Float
  evidence          String

  x           Float
  y           Float
  width       Float
  height      Float
  hasLocation Boolean @default(true)

  resolutionStatus SheetReferenceResolution
  metadataVersion  String                   @default("sheet-reference-v1")

  sourcePageId String
  sourcePage   DrawingPage @relation(fields: [sourcePageId], references: [id], onDelete: Cascade)

  targetSheetId String?
  targetSheet   Sheet?  @relation("ReferenceTargetSheet", fields: [targetSheetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourcePageId])
  @@index([targetSheetId])
  @@index([resolutionStatus])
  @@index([targetSheetNumber])
  @@map("sheet_references")
}

model Analysis {
  id             String  @id @default(uuid())
  score          Int?
  summary        String?
  issuesSnapshot Json?   @map("issues")
  rawOutput      Json?
  reportUrl      String?

  reviewMode    ReviewMode     @default(SUBMISSION_READINESS)
  status        AnalysisStatus @default(PENDING)
  errorCode     String?
  errorMessage  String?
  provider      String?
  model         String?
  promptVersion String         @default("v1")
  attempt       Int            @default(0)
  durationMs    Int?
  startedAt     DateTime?
  completedAt   DateTime?

  drawingId String
  drawing   Drawing         @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  issues    AnalysisIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([drawingId, reviewMode, createdAt])
  @@index([status])
  @@map("analyses")
}

model AnalysisIssue {
  id             String              @id @default(uuid())
  title          String
  category       String
  severity       String
  confidence     Float
  page           Int
  x              Float
  y              Float
  width          Float
  height         Float
  hasLocation    Boolean             @default(true)
  explanation    String
  recommendation String
  status         AnalysisIssueStatus @default(OPEN)
  reviewReason   String?
  reviewerNote   String?
  reviewedAt     DateTime?

  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  reviewEvents AnalysisIssueReviewEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analysisId, status])
  @@index([severity])
  @@map("analysis_issues")
}

model AnalysisIssueReviewEvent {
  id             String              @id @default(uuid())
  previousStatus AnalysisIssueStatus
  status         AnalysisIssueStatus
  reason         String?
  note           String?

  issueId String
  issue   AnalysisIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("analysis_issue_review_events")
}

model RefreshSession {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

enum ReviewMode {
  SUBMISSION_READINESS
  DOCUMENTATION_REVIEW
  CONSTRUCTABILITY_REVIEW
  COORDINATION_REVIEW
  COMPLIANCE_RISK_REVIEW
}

enum DrawingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AnalysisIssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum SheetReviewStatus {
  AI_EXTRACTED
  NEEDS_REVIEW
  CORRECTED
  CONFIRMED
}

enum NativePdfExtractionStatus {
  PENDING
  AVAILABLE
  NO_TEXT
  FAILED
}

enum DrawingPageRegionKind {
  GRID
  TITLE_BLOCK
}

enum DrawingPageRegionStatus {
  PENDING
  AVAILABLE
  FAILED
}

enum SheetReferenceType {
  DETAIL
  SECTION
  ELEVATION
  SCHEDULE
  PLAN
  GENERAL
  OTHER
}

enum SheetReferenceResolution {
  RESOLVED
  MISSING_TARGET
  AMBIGUOUS_TARGET
  LOW_CONFIDENCE
}

enum ProjectQuestionStatus {
  ANSWERED
  INSUFFICIENT_EVIDENCE
}

enum CheckSeverity {
  LOW
  MEDIUM
  HIGH
}
