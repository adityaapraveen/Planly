PORT=3000
NODE_ENV=dev
CLIENT_URL=http://localhost:5173
# Set to the exact number of trusted reverse proxies in production. Keep 0 locally.
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/planly

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
ASSET_SIGNING_SECRET=replace-with-a-dedicated-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_EXPIRES_IN=7

# Free three-model OpenRouter stack: generation, embeddings, and reranking are separate.
AI_PROVIDER=openrouter
AI_REQUIRE_FREE_MODELS=true

OPENAI_API_KEY=
OPENAI_MODEL=

# Semantic retrieval uses OpenRouter's free 1,024-dimensional Liquid model by default.
# OpenRouter/Liquid may retain successful embedding inputs for model improvement;
# set AI_EMBEDDING_ENABLED=false when project policy does not allow that data flow.
AI_EMBEDDING_ENABLED=true
AI_EMBEDDING_PROVIDER=openrouter
AI_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_INPUT_MAX_CHARS=1600

# Optional second-stage precision pass over the bounded first-stage candidates.
AI_RERANK_ENABLED=true
AI_RERANK_PROVIDER=openrouter
AI_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
AI_RERANK_MAX_CANDIDATES=40

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free

AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=0
AI_PROMPT_VERSION=v1
ANALYSIS_DAILY_LIMIT=25
AI_QUESTION_DAILY_LIMIT=50
ASSET_URL_TTL_SECONDS=900
